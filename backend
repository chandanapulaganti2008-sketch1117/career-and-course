// Get all available careers
app.get("/api/careers", (req, res) => {
    const allCareers = Object.values(careers).flat();
    res.json({
        success: true,
        total: allCareers.length,
        careers: allCareers
    });
});

// Get careers by stream
app.get("/api/careers/:stream", (req, res) => {
    const stream = req.params.stream.toLowerCase();

    if (!careers[stream]) {
        return res.status(404).json({
            success: false,
            message: "Stream not found. Choose science, commerce, or arts."
        });
    }

    res.json({
        success: true,
        stream: stream,
        careers: careers[stream]
    });
});

// Career and course advisor chatbot
app.post("/api/chat", (req, res) => {
    const { message, stream, interests } = req.body;

    if (!message || typeof message !== "string") {
        return res.status(400).json({
            success: false,
            message: "Please enter a valid message."
        });
    }

    const userMessage = message.toLowerCase();
    const selectedStream = (stream || "").toLowerCase();
    const userInterests = Array.isArray(interests)
        ? interests.map(item => String(item).toLowerCase())
        : [];

    let recommendations = Object.values(careers).flat();

    // Filter by educational stream when provided
    if (careers[selectedStream]) {
        recommendations = careers[selectedStream];
    }

    // Filter by interests when provided
    if (userInterests.length > 0) {
        const matchedCareers = recommendations.filter(item =>
            item.skills.some(skill =>
                userInterests.some(interest =>
                    skill.toLowerCase().includes(interest) ||
                    interest.includes(skill.toLowerCase())
                )
            )
        );

        if (matchedCareers.length > 0) {
            recommendations = matchedCareers;
        }
    }

    let reply;

    if (
        userMessage.includes("hello") ||
        userMessage.includes("hi") ||
        userMessage.includes("hey")
    ) {
        reply =
            "Hello! Welcome to the Career and Course Advisor. " +
            "Tell me your educational stream and interests, and I will suggest suitable career options.";
    } else if (
        userMessage.includes("course") ||
        userMessage.includes("career") ||
        userMessage.includes("job") ||
        userMessage.includes("future") ||
        userMessage.includes("recommend")
    ) {
        reply = "Here are some career options to explore based on your information.";
    } else {
        reply =
            "I can help you explore careers and courses. " +
            "Tell me your stream (science, commerce, or arts) and the subjects or skills you enjoy.";
    }

    res.json({
        success: true,
        reply: reply,
        recommendations: recommendations
    });
});

// Handle unknown routes
app.use((req, res) => {
    res.status(404).json({
        success: false,
        message: "API route not found."
    });
});

// Start server
app.listen(PORT, () => {
    console.log(`Career Advisor server running at http://localhost:${PORT}`);
});