*  {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background: #f7f8ff;
  color: #202344;
  line-height: 1.6;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 8%;
  background: white;
  box-shadow: 0 2px 12px #20234410;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: #5544d8;
}

.logo span {
  color: #222449;
}

nav {
  display: flex;
  gap: 22px;
}

nav a {
  text-decoration: none;
  color: #333653;
  font-size: 14px;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 85px 10%;
  background: linear-gradient(120deg, #eeedff, #f8f9ff);
}

.hero-content {
  max-width: 570px;
}

.tag {
  color: #6554dc;
  font-weight: bold;
  font-size: 13px;
  letter-spacing: 2px;
}

h1 {
  font-size: clamp(34px, 5vw, 55px);
  line-height: 1.15;
  margin: 18px 0;
}

h1 span {
  color: #6554dc;
}

.intro {
  color: #666a82;
  margin-bottom: 28px;
}

.main-button {
  display: inline-block;
  background: #6554dc;
  color: white;
  padding: 13px 22px;
  border-radius: 9px;
  text-decoration: none;
  font-weight: bold;
}

.hero-card {
  min-width: 240px;
  padding: 35px 25px;
  background: white;
  border-radius: 20px;
  text-align: center;
  box-shadow: 0 12px 35px #6554dc18;
}

.cap {
  font-size: 65px;
  margin-bottom: 15px;
}

.hero-card p,
.card p {
  color: #73758a;
  font-size: 14px;
  margin-top: 8px;
}

.features,
.advisor {
  padding: 65px 8%;
  text-align: center;
}

h2 {
  font-size: 30px;
}

.section-text {
  color: #73758a;
  margin: 10px 0 30px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  margin-top: 30px;
}

.card {
  background: white;
  padding: 28px 20px;
  border-radius: 15px;
  border: 1px solid #e9e8f8;
  transition: transform 0.2s;
}

.card:hover {
  transform: translateY(-5px);
}

.emoji {
  font-size: 38px;
  margin-bottom: 12px;
}

.advisor {
  background: #eeedff;
}

.advisor > p {
  color: #6c6d83;
  margin: 10px 0 20px;
}

.chat-box {
  max-width: 650px;
  height: 300px;
  overflow-y: auto;
  background: white;
  border-radius: 14px;
  padding: 20px;
  margin: 25px auto 15px;
  text-align: left;
}

.message {
  padding: 12px 15px;
  border-radius: 12px;
  margin-bottom: 12px;
  max-width: 85%;
  white-space: pre-line;
}

.bot {
  background: #eeedff;
  color: #302d5c;
}

.user {
  background: #6554dc;
  color: white;
  margin-left: auto;
}

#chatForm {
  display: flex;
  max-width: 650px;
  gap: 10px;
  margin: auto;
}

#userInput {
  flex: 1;
  min-width: 0;
  padding: 14px;
  border: 1px solid #d9d7f2;
  border-radius: 9px;
  font-size: 15px;
}

#chatForm button {
  padding: 12px 20px;
  background: #6554dc;
  color: white;
  border: none;
  border-radius: 9px;
  cursor: pointer;
}

.note {
  font-size: 12px;
}

footer {
  text-align: center;
  padding: 22px;
  background: white;
  color: #77798d;
  font-size: 13px;
}

@media (max-width: 700px) {
  header {
    flex-direction: column;
    gap: 15px;
  }

  nav {
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    flex-direction: column;
    text-align: center;
    padding: 55px 7%;
  }

  .hero-card {
    width: 100%;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .features,
  .advisor {
    padding: 45px 6%;
  }

  h2 {
    font-size: 25px;
  }

  #chatForm button {
    padding: 12px;
  }
}
/* Career Advisor Section */

.advisor {

    max-width: 800px;

    margin: 50px auto;

    padding: 30px;

    background: white;

    border-radius: 15px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);

}

.advisor h2 {

    text-align: center;

    margin-bottom: 12px;

}

.advisor > p {

    text-align: center;

    margin-bottom: 20px;

}

/* Chat area */

.chat-box {

    height: 300px;

    overflow-y: auto;

    padding: 20px;

    background: #f4f7ff;

    border-radius: 12px;

    margin-bottom: 20px;

}

.message {

    padding: 12px 15px;

    margin-bottom: 12px;

    border-radius: 12px;

    max-width: 85%;

    line-height: 1.5;

}

.bot {

    background: #e0eaff;

    color: #172554;

    margin-right: auto;

}

.user {

    background: #2563eb;

    color: white;

    margin-left: auto;

}

/* Chat input */

#chatForm {

    display: flex;

    gap: 10px;

}

#userInput {

    flex: 1;

    min-width: 0;

    padding: 13px;

    border: 1px solid #ccc;

    border-radius: 8px;

    font-size: 15px;

}

#chatForm button {

    padding: 12px 20px;

    background: #2563eb;

    color: white;

    border: none;

    border-radius: 8px;

    cursor: pointer;

}

#chatForm button:hover {

    background: #1d4ed8;

}

.note {

    font-size: 13px;

    color: #666;

    margin-top: 15px;

}

@media (max-width: 600px) {

    .advisor {

        margin: 25px 15px;

        padding: 20px;

    }

    #chatForm {

        flex-direction: column;

    }

    #chatForm button {

        width: 100%;
    }
  }